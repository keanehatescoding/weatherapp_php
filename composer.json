{
    "name": "keanehatescoding/weatherapp-php",
    "description": "Simple, responsive PHP weather application using the OpenWeatherMap API.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-session": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^1.11"
    },
    "scripts": {
        "test": [
            "@php tests/test_weather.php",
            "@php tests/test_ratelimit.php",
            "@php tests/test_onecall.php",
            "@php tests/test_http.php",
            "@php tests/test_controller.php"
        ],
        "lint": "for f in *.php app/*.php tests/*.php; do \"$PHP_BINARY\" -l \"$f\" || exit 1; done",
        "static-analysis": "@php vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    }
}
