# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your real key.

# Your OpenWeatherMap API key (free tier works).
OPENWEATHERMAP_API_KEY=your_api_key_here

# Optional: comma-separated trusted proxy IPs. Only set this when your app
# sits behind a load balancer / CDN (e.g. Cloudflare, NGINX). Leave empty
# to treat REMOTE_ADDR as the client directly.
# TRUSTED_PROXIES=127.0.0.1,10.0.0.1
